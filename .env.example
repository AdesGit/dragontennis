# Public Convex URL the browser connects to (tennis dedicated instance)
NEXT_PUBLIC_CONVEX_URL=https://convex-tennis.aidigitalassistant.cloud

# Optional: shared secret for CLI backup/import.
# Must also be set in Convex env with the same value.
BACKUP_ADMIN_SECRET=change-me

# Backup cron: daily JSON export, optional email delivery, local retention.
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=31
BACKUP_EMAIL_RECIPIENTS=christian.gall@gmail.com
# daily = email every backup, weekly = email only on BACKUP_EMAIL_WEEKDAY, never = no email
BACKUP_EMAIL_FREQUENCY=weekly
# 0=Sunday, 1=Monday, ..., 6=Saturday
BACKUP_EMAIL_WEEKDAY=1

# Gmail SMTP credentials used by invitation/reset emails and backup email attachments.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
GMAIL_FROM="Dragon Tennis <your-gmail-address@gmail.com>"
